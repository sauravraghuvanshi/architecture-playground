# Public site URL used for canonical metadata (set per environment)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional workspace access gate. Keep credentials in environment settings;
# never commit populated values. APP_AUTH_SECRET must be at least 32 characters.
# APP_AUTH_ENABLED=true
# APP_AUTH_USERNAME=
# APP_AUTH_PASSWORD=
# APP_AUTH_SECRET=

# Azure OpenAI chat — enables prompt-to-diagram generation.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21

# Optional dedicated image resource for Whiteboard AI.
# AZURE_OPENAI_IMAGE_ENDPOINT=https://<your-image-resource>.openai.azure.com
# AZURE_OPENAI_IMAGE_API_KEY=
# AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2

# Development only: when image credentials are absent, the app proxies image
# requests through the public Diagrammatic demo without exposing Azure keys.
# Set to "disabled" to opt out, or provide another trusted Diagrammatic base URL.
# DIAGRAMMATIC_AI_PROXY_URL=disabled
